----------------------------------------------------------------------
-- TARGETING
----------------------------------------------------------------------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function getAimPart(char: Model): BasePart?
	local part
	if S.AimPart == "Torso" then
		part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") -- R15 / R6
	else
		part = char:FindFirstChild(S.AimPart)
	end
	return (part or char:FindFirstChild("HumanoidRootPart")) :: BasePart?
end

local function hasLineOfSight(origin: Vector3, part: BasePart, targetChar: Instance): boolean
	rayParams.FilterDescendantsInstances = { player.Character, targetChar }
	return Workspace:Raycast(origin, part.Position - origin, rayParams) == nil
end

-- picks the living player closest to the crosshair inside the FOV cone
local function getTarget(maxAngle: number): BasePart?
	local camCF = camera.CFrame
	local best: BasePart? = nil
	local bestAngle = math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == player then
			continue
		end
		if S.IgnoreTeammates and plr.Team ~= nil and plr.Team == player.Team then
			continue
		end

		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local part = char and getAimPart(char)

		if hum and part and hum.Health > 0 then
			local dir = part.Position - camCF.Position
			if dir.Magnitude <= S.MaxDistance then
				local angle = math.deg(math.acos(math.clamp(camCF.LookVector:Dot(dir.Unit), -1, 1)))
				if angle <= maxAngle and angle < bestAngle then
					if not S.WallCheck or hasLineOfSight(camCF.Position, part, char) then
						best, bestAngle = part, angle
					end
				end
			end
		end
	end

	return best
end

----------------------------------------------------------------------
-- ESP: highlight (glow), 2D box, skeleton
-- (Highlights show through walls; Roblox allows ~31 active at once,
-- so lower the ESP distance slider in big servers)
----------------------------------------------------------------------
local R15_BONES = {
	{ "Head", "UpperTorso" },
	{ "UpperTorso", "LowerTorso" },
	{ "UpperTorso", "LeftUpperArm" },
	{ "LeftUpperArm", "LeftLowerArm" },
	{ "LeftLowerArm", "LeftHand" },
	{ "UpperTorso", "RightUpperArm" },
	{ "RightUpperArm", "RightLowerArm" },
	{ "RightLowerArm", "RightHand" },
	{ "LowerTorso", "LeftUpperLeg" },
	{ "LeftUpperLeg", "LeftLowerLeg" },
	{ "LeftLowerLeg", "LeftFoot" },
	{ "LowerTorso", "RightUpperLeg" },
	{ "RightUpperLeg", "RightLowerLeg" },
	{ "RightLowerLeg", "RightFoot" },
}
local MAX_BONES = #R15_BONES -- R6 characters use fewer

local espObjects = {}

local function getObjects(plr: Player)
	local obj = espObjects[plr]
	if obj then
		return obj
	end

	local folder = new("Folder", { Name = plr.Name }, overlay)
	local box = new("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false }, folder)
	local boxStroke = new("UIStroke", { Thickness = 1.5, LineJoinMode = Enum.LineJoinMode.Miter }, box)
	local lines = {}
	for i = 1, MAX_BONES do
		lines[i] = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BorderSizePixel = 0,
			Visible = false,
		}, folder)
	end

	obj = { folder = folder, box = box, boxStroke = boxStroke, lines = lines, highlight = nil, shown = false }
	espObjects[plr] = obj
	return obj
end

local function hideESP(plr: Player)
	local obj = espObjects[plr]
	if obj and obj.shown then
		obj.shown = false
		obj.box.Visible = false
		for _, line in ipairs(obj.lines) do
			line.Visible = false
		end
		if obj.highlight then
			obj.highlight:Destroy()
			obj.highlight = nil
		end
	end
end

local function removeESP(plr: Player)
	local obj = espObjects[plr]
	if obj then
		if obj.highlight then
			obj.highlight:Destroy()
		end
		obj.folder:Destroy()
		espObjects[plr] = nil
	end
end

Players.PlayerRemoving:Connect(removeESP)

local function getESPColor(plr: Player): Color3
	if S.ESPTeamColors and plr.Team ~= nil then
		return plr.Team.TeamColor.Color
	end
	return Color3.fromHSV(S.ESPHue, S.ESPSat, S.ESPVal)
end

-- list of {pointA, pointB} world-space bones for a character (R6 or R15)
local function getBones(char: Model): { { Vector3 } }
	local bones = {}
	local function add(a: Vector3?, b: Vector3?)
		if a and b then
			table.insert(bones, { a, b })
		end
	end

	if char:FindFirstChild("Torso") then -- R6
		local function point(partName: string, y: number): Vector3?
			local part = char:FindFirstChild(partName)
			if part and part:IsA("BasePart") then
				return (part.CFrame * CFrame.new(0, y, 0)).Position
			end
			return nil
		end

		local head = point("Head", 0)
		local neck = point("Torso", 1)
		local pelvis = point("Torso", -1)
		add(head, neck)
		add(neck, pelvis)
		for _, limb in ipairs({ "Left Arm", "Right Arm" }) do
			local shoulder, hand = point(limb, 1), point(limb, -1)
			add(neck, shoulder)
			add(shoulder, hand)
		end
		for _, limb in ipairs({ "Left Leg", "Right Leg" }) do
			local hip, foot = point(limb, 1), point(limb, -1)
			add(pelvis, hip)
			add(hip, foot)
		end
	else -- R15
		for _, pair in ipairs(R15_BONES) do
			local a, b = char:FindFirstChild(pair[1]), char:FindFirstChild(pair[2])
			if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
				add(a.Position, b.Position)
			end
		end
	end

	return bones
end

-- draws a 2D line between two screen points using a rotated frame
local function setLine(line: Frame, a: Vector2, b: Vector2, color: Color3, thickness: number)
	local delta = b - a
	line.Size = UDim2.fromOffset(delta.Magnitude, thickness)
	line.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
	line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
	line.BackgroundColor3 = color
	line.Visible = true
end

local function updateESP()
	local camPos = camera.CFrame.Position

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == player then
			continue
		end

		local char = plr.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local isTeammate = plr.Team ~= nil and plr.Team == player.Team

		local show = S.ESP
			and char ~= nil
			and hum ~= nil
			and hum.Health > 0
			and root ~= nil
			and (S.ESPShowTeammates or not isTeammate)
			and ((root :: BasePart).Position - camPos).Magnitude <= S.ESPMaxDistance

		if not show then
			hideESP(plr)
			continue
		end

		local obj = getObjects(plr)
		obj.shown = true
		local color = getESPColor(plr)
		local thickness = S.ESPThickness

		-- highlight (glow through walls)
		if S.ESPHighlight then
			local h = obj.highlight
			if not h or h.Parent ~= char then
				if h then
					h:Destroy()
				end
				h = Instance.new("Highlight")
				h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				h.Parent = char
				obj.highlight = h
			end
			h.FillColor = color
			h.OutlineColor = color
			h.FillTransparency = S.ESPFill and 0.65 or 1
			h.OutlineTransparency = 0
		elseif obj.highlight then
			obj.highlight:Destroy()
			obj.highlight = nil
		end

		-- 2D box (size is estimated from the root part, so it stays steady while animating)
		local rootPos = (root :: BasePart).Position
		local top = camera:WorldToViewportPoint(rootPos + Vector3.new(0, 2.7, 0))
		local bottom = camera:WorldToViewportPoint(rootPos - Vector3.new(0, 3.1, 0))
		if S.ESPBox and top.Z > 0 and bottom.Z > 0 then
			local height = bottom.Y - top.Y
			local width = height * 0.6
			obj.box.Position = UDim2.fromOffset(top.X - width / 2, top.Y)
			obj.box.Size = UDim2.fromOffset(width, height)
			obj.boxStroke.Color = color
			obj.boxStroke.Thickness = thickness
			obj.box.Visible = true
		else
			obj.box.Visible = false
		end

		-- skeleton
		local used = 0
		if S.ESPSkeleton then
			for _, bone in ipairs(getBones(char :: Model)) do
				local a = camera:WorldToViewportPoint(bone[1])
				local b = camera:WorldToViewportPoint(bone[2])
				if a.Z > 0 and b.Z > 0 and used < MAX_BONES then
					used += 1
					setLine(obj.lines[used], Vector2.new(a.X, a.Y), Vector2.new(b.X, b.Y), color, thickness)
				end
			end
		end
		for i = used + 1, MAX_BONES do
			obj.lines[i].Visible = false
		end
	end
end

----------------------------------------------------------------------
-- AIM LOOP
----------------------------------------------------------------------
local holding = false

RunService:BindToRenderStep("AimAssist", Enum.RenderPriority.Camera.Value + 1, function(dt)
	camera = Workspace.CurrentCamera
	updateHud()
	updateESP()

	if not S.Enabled then
		return
	end
	if S.RequireHold and not holding then
		return
	end

	local target = getTarget(S.Fov)
	if target then
		local goal = CFrame.lookAt(camera.CFrame.Position, target.Position)
		local alpha = 1 - math.exp(-S.Speed * dt) -- framerate-independent smoothing
		camera.CFrame = camera.CFrame:Lerp(goal, alpha)
	end
end)

----------------------------------------------------------------------
-- INPUT
----------------------------------------------------------------------
-- FOV keys: normal press = FovStep, holding Left Shift = FovFineStep
local function nudgeFov(direction: number)
	local fine = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
	S.Fov = clampFov(S.Fov + direction * (fine and S.FovFineStep or S.FovStep))
	refreshAll()
end

local function matches(input: InputObject, bind: EnumItem): boolean
	if bind.EnumType == Enum.KeyCode then
		return input.KeyCode == bind
	end
	return input.UserInputType == bind
end

UserInputService.InputBegan:Connect(function(input, processed)
	-- rebinding: the next key (or right/middle mouse button) becomes the new bind
	if listening then
		if input.KeyCode == Enum.KeyCode.Escape then
			listening = nil
		elseif input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode ~= Enum.KeyCode.Unknown then
			S.Keys[listening] = input.KeyCode
			listening = nil
		elseif
			input.UserInputType == Enum.UserInputType.MouseButton2
			or input.UserInputType == Enum.UserInputType.MouseButton3
		then
			S.Keys[listening] = input.UserInputType
			listening = nil
		else
			return
		end
		refreshAll()
		return
	end

	if processed then
		return
	end

	if matches(input, S.Keys.AimHold) then
		holding = true
	end

	if matches(input, S.Keys.ToggleAim) then
		S.Enabled = not S.Enabled
		refreshAll()
	elseif matches(input, S.Keys.ToggleESP) then
		S.ESP = not S.ESP
		refreshAll()
	elseif matches(input, S.Keys.FovUp) then
		nudgeFov(1)
	elseif matches(input, S.Keys.FovDown) then
		nudgeFov(-1)
	elseif matches(input, S.Keys.Menu) then
		panel.Visible = not panel.Visible
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if matches(input, S.Keys.AimHold) then
		holding = false
	end
end)
