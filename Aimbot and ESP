-- LocalScript → StarterPlayer > StarterPlayerScripts
-- Aim assist + ESP with a settings panel: every option is adjustable in-game and all keys are rebindable.
-- Open/close the panel with the Menu key (default RightShift) or the AIM button on screen.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

----------------------------------------------------------------------
-- SETTINGS (defaults - everything below can be changed from the UI)
----------------------------------------------------------------------
local function defaults()
	return {
		Enabled = false,
		RequireHold = not UserInputService.TouchEnabled, -- on mobile there is no hold key, so default to always-on
		WallCheck = true,
		IgnoreTeammates = true,
		ShowFovCircle = true,
		AimPart = "Head", -- Head / Torso / HumanoidRootPart
		Fov = 30, -- cone half-angle in degrees
		Speed = 12, -- lock-on snappiness (low = smooth, high = snap)
		MaxDistance = 500, -- studs
		FovStep = 5, -- degrees per FovUp/FovDown key press
		FovFineStep = 0.5, -- degrees per press while holding Left Shift, and for the -/+ buttons
		ESP = false,
		ESPTeamColors = true, -- outline players in their team's color
		ESPShowTeammates = true,
		ESPHighlight = true, -- full-body glow/outline
		ESPBox = false, -- 2D box around each player
		ESPSkeleton = false, -- bone lines
		ESPFill = true, -- highlight fill (false = outline only)
		ESPThickness = 1.5, -- box/skeleton line thickness (px)
		ESPHue = 0, -- color wheel hue (0-1)
		ESPSat = 0.76, -- color wheel saturation (0-1)
		ESPVal = 1, -- color brightness (0-1)
		ESPMaxDistance = 1000, -- studs
		Keys = {
			ToggleAim = Enum.KeyCode.Q,
			ToggleESP = Enum.KeyCode.E,
			AimHold = Enum.UserInputType.MouseButton2,
			FovUp = Enum.KeyCode.RightBracket,
			FovDown = Enum.KeyCode.LeftBracket,
			Menu = Enum.KeyCode.RightShift,
		},
	}
end

local S = defaults()
local AIM_PARTS = { "Head", "Torso", "HumanoidRootPart" }

local FOV_MIN, FOV_MAX = 1, 90 -- degrees
local function clampFov(v: number): number
	return math.clamp(math.floor(v * 10 + 0.5) / 10, FOV_MIN, FOV_MAX) -- keeps 0.1 precision
end

local THEME = {
	Panel = Color3.fromRGB(24, 24, 30),
	Row = Color3.fromRGB(34, 34, 42),
	Accent = Color3.fromRGB(90, 140, 255),
	Text = Color3.fromRGB(235, 235, 240),
	Dim = Color3.fromRGB(150, 150, 165),
	Off = Color3.fromRGB(70, 70, 82),
}

----------------------------------------------------------------------
-- SMALL UI HELPERS
----------------------------------------------------------------------
local function new(class: string, props: { [string]: any }, parent: Instance?)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function round(inst: Instance, radius: number)
	new("UICorner", { CornerRadius = UDim.new(0, radius) }, inst)
end

local playerGui = player:WaitForChild("PlayerGui")

-- overlay ignores the top-bar inset so the FOV circle sits exactly on the crosshair
local overlay = new("ScreenGui", {
	Name = "AimAssistOverlay",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	DisplayOrder = 99,
}, playerGui)

local ui = new("ScreenGui", {
	Name = "AimAssistUI",
	ResetOnSpawn = false,
	DisplayOrder = 100,
}, playerGui)

----------------------------------------------------------------------
-- FOV CIRCLE + STATUS
----------------------------------------------------------------------
local circle = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	BackgroundTransparency = 1,
	Visible = false,
}, overlay)
new("UIStroke", { Thickness = 1.5, Color = Color3.new(1, 1, 1), Transparency = 0.3 }, circle)
new("UICorner", { CornerRadius = UDim.new(1, 0) }, circle)

local status = new("TextLabel", {
	BackgroundTransparency = 1,
	Position = UDim2.fromOffset(12, 8),
	Size = UDim2.fromOffset(420, 20),
	TextXAlignment = Enum.TextXAlignment.Left,
	Font = Enum.Font.GothamMedium,
	TextSize = 14,
	TextColor3 = Color3.new(1, 1, 1),
	TextStrokeTransparency = 0.5,
}, ui)

local function updateHud()
	status.Text = ("Aim [%s]: %s   ESP [%s]: %s   FOV: %g°"):format(
		S.Keys.ToggleAim.Name,
		S.Enabled and "ON" or "OFF",
		S.Keys.ToggleESP.Name,
		S.ESP and "ON" or "OFF",
		S.Fov
	)

	local show = S.ShowFovCircle and S.Enabled
	circle.Visible = show
	if show then
		-- convert cone half-angle to a pixel radius on screen
		local focal = (camera.ViewportSize.Y / 2) / math.tan(math.rad(camera.FieldOfView / 2))
		local radius = math.tan(math.rad(S.Fov)) * focal
		circle.Size = UDim2.fromOffset(radius * 2, radius * 2)
	end
end

----------------------------------------------------------------------
-- SETTINGS PANEL
----------------------------------------------------------------------
local refreshers = {}
local function refreshAll()
	for _, fn in ipairs(refreshers) do
		fn()
	end
end

local listening: string? = nil -- name of the keybind currently being rebound

local panel = new("Frame", {
	Name = "Panel",
	Size = UDim2.new(0, 300, 0.85, 0),
	Position = UDim2.new(0, 20, 0.075, 0),
	BackgroundColor3 = THEME.Panel,
	BorderSizePixel = 0,
	Active = true, -- stops clicks from passing through to the camera
}, ui)
round(panel, 10)
new("UIStroke", { Color = Color3.fromRGB(60, 60, 75), Thickness = 1 }, panel)
new("UISizeConstraint", { MaxSize = Vector2.new(300, 580) }, panel)

local titleBar = new("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1 }, panel)
new("TextLabel", {
	Size = UDim2.new(1, -50, 1, 0),
	Position = UDim2.fromOffset(14, 0),
	BackgroundTransparency = 1,
	Text = "Aim Assist",
	Font = Enum.Font.GothamBold,
	TextSize = 15,
	TextColor3 = THEME.Text,
	TextXAlignment = Enum.TextXAlignment.Left,
}, titleBar)

local closeBtn = new("TextButton", {
	Size = UDim2.fromOffset(28, 28),
	Position = UDim2.new(1, -34, 0, 4),
	BackgroundColor3 = THEME.Row,
	Text = "X",
	Font = Enum.Font.GothamBold,
	TextSize = 13,
	TextColor3 = THEME.Text,
}, titleBar)
round(closeBtn, 6)
closeBtn.Activated:Connect(function()
	panel.Visible = false
end)

-- drag the panel by its title bar
do
	local dragging, dragStart, startPos = false, Vector2.zero, panel.Position
	titleBar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startPos = panel.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
			panel.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

local list = new("ScrollingFrame", {
	Position = UDim2.fromOffset(0, 40),
	Size = UDim2.new(1, 0, 1, -44),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	ScrollBarThickness = 4,
	CanvasSize = UDim2.new(),
