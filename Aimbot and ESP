local function makeToggle(text: string, key: string)
	local row = makeRow(36)
	makeLabel(row, text, 70)
	local pill = new("TextButton", {
		Size = UDim2.fromOffset(40, 20),
		Position = UDim2.new(1, -50, 0.5, -10),
		Text = "",
		AutoButtonColor = false,
	}, row)
	round(pill, 10)
	local knob = new("Frame", {
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, pill)
	round(knob, 8)

	local function refresh()
		local on = S[key]
		pill.BackgroundColor3 = on and THEME.Accent or THEME.Off
		knob.Position = on and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
	end
	pill.Activated:Connect(function()
		S[key] = not S[key]
		refreshAll()
	end)
	table.insert(refreshers, refresh)
	refresh()
end

local function makeSlider(text: string, key: string, min: number, max: number, step: number, suffix: string)
	local row = makeRow(50)
	new("TextLabel", {
		Size = UDim2.new(0.6, 0, 0, 24),
		Position = UDim2.fromOffset(12, 2),
		BackgroundTransparency = 1,
		Text = text,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local valueLabel = new("TextLabel", {
		Size = UDim2.new(0.4, -12, 0, 24),
		Position = UDim2.new(0.6, 0, 0, 2),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = THEME.Accent,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)
	local track = new("Frame", {
		Size = UDim2.new(1, -24, 0, 6),
		Position = UDim2.new(0, 12, 0, 34),
		BackgroundColor3 = THEME.Off,
		BorderSizePixel = 0,
	}, row)
	round(track, 3)
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = THEME.Accent,
		BorderSizePixel = 0,
	}, track)
	round(fill, 3)
	local hit = new("TextButton", {
		Size = UDim2.new(1, -12, 0, 22),
		Position = UDim2.new(0, 6, 0, 26),
		BackgroundTransparency = 1,
		Text = "",
	}, row)

	local function refresh()
		local v = S[key]
		fill.Size = UDim2.fromScale(math.clamp((v - min) / (max - min), 0, 1), 1)
		valueLabel.Text = string.format("%g%s", v, suffix)
	end

	local dragging = false
	local function setFromX(x: number)
		local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local v = min + rel * (max - min)
		v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
		S[key] = v
		refreshAll()
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	table.insert(refreshers, refresh)
	refresh()
end

local function makeCycle(text: string, key: string, options: { string })
	local row = makeRow(36)
	makeLabel(row, text, 150)
	local btn = new("TextButton", {
		Size = UDim2.fromOffset(120, 24),
		Position = UDim2.new(1, -132, 0.5, -12),
		BackgroundColor3 = THEME.Off,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = THEME.Text,
	}, row)
	round(btn, 6)

	local function refresh()
		btn.Text = S[key]
	end
	btn.Activated:Connect(function()
		local idx = table.find(options, S[key]) or 0
		S[key] = options[idx % #options + 1]
		refreshAll()
	end)
	table.insert(refreshers, refresh)
	refresh()
end

local function makeKeybind(text: string, name: string)
	local row = makeRow(36)
	makeLabel(row, text, 150)
	local btn = new("TextButton", {
		Size = UDim2.fromOffset(120, 24),
		Position = UDim2.new(1, -132, 0.5, -12),
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = THEME.Text,
	}, row)
	round(btn, 6)

	local function refresh()
		local active = listening == name
		btn.Text = active and "Press a key..." or S.Keys[name].Name
		btn.BackgroundColor3 = active and THEME.Accent or THEME.Off
	end
	btn.Activated:Connect(function()
		listening = (listening == name) and nil or name
		refreshAll()
	end)
	table.insert(refreshers, refresh)
	refresh()
end

-- FOV control: type an exact value, drag the slider (hold Left Shift for fine control), or nudge with -/+
local function makeFovControl()
	local row = makeRow(104)

	new("TextLabel", {
		Size = UDim2.new(0.5, 0, 0, 26),
		Position = UDim2.fromOffset(12, 2),
		BackgroundTransparency = 1,
		Text = "FOV (aim cone)",
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local box = new("TextBox", {
		Size = UDim2.fromOffset(64, 22),
		Position = UDim2.new(1, -90, 0, 4),
		BackgroundColor3 = THEME.Off,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = THEME.Accent,
		ClearTextOnFocus = false,
		Text = "",
	}, row)
	round(box, 6)
	new("TextLabel", {
		Size = UDim2.fromOffset(14, 22),
		Position = UDim2.new(1, -24, 0, 4),
		BackgroundTransparency = 1,
		Text = "°",
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextColor3 = THEME.Dim,
	}, row)

	local function makeNudge(label: string, position: UDim2)
		local btn = new("TextButton", {
			Size = UDim2.fromOffset(26, 24),
			Position = position,
			BackgroundColor3 = THEME.Off,
			Text = label,
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			TextColor3 = THEME.Text,
		}, row)
		round(btn, 6)
		return btn
	end
	local minus = makeNudge("-", UDim2.fromOffset(12, 38))
	local plus = makeNudge("+", UDim2.new(1, -38, 0, 38))

	local track = new("Frame", {
		Size = UDim2.new(1, -92, 0, 6),
		Position = UDim2.fromOffset(46, 47),
		BackgroundColor3 = THEME.Off,
		BorderSizePixel = 0,
	}, row)
	round(track, 3)
	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = THEME.Accent,
		BorderSizePixel = 0,
	}, track)
	round(fill, 3)
	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, track)
	round(knob, 7)
	local hit = new("TextButton", {
		Size = UDim2.new(1, -84, 0, 26),
		Position = UDim2.fromOffset(42, 37),
		BackgroundTransparency = 1,
		Text = "",
	}, row)

	new("TextLabel", {
		Size = UDim2.new(1, -24, 0, 32),
		Position = UDim2.fromOffset(12, 68),
		BackgroundTransparency = 1,
		Text = "Hold Left Shift while dragging (or while using the FOV keys) for fine control. Type a value for an exact FOV.",
		Font = Enum.Font.Gotham,
		TextSize = 11,
		TextColor3 = THEME.Dim,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, row)

	local function refresh()
		local rel = (S.Fov - FOV_MIN) / (FOV_MAX - FOV_MIN)
		fill.Size = UDim2.fromScale(rel, 1)
		knob.Position = UDim2.fromScale(rel, 0.5)
		if not box:IsFocused() then
			box.Text = string.format("%g", S.Fov)
		end
	end

	local function setFov(v: number)
		S.Fov = clampFov(v)
		refreshAll()
	end

	-- -/+ buttons use the fine step
	minus.Activated:Connect(function()
		setFov(S.Fov - S.FovFineStep)
	end)
	plus.Activated:Connect(function()
		setFov(S.Fov + S.FovFineStep)
	end)

	-- typed value
	box.FocusLost:Connect(function()
		local n = tonumber(string.match(box.Text, "[%d%.]+"))
		if n then
			S.Fov = clampFov(n)
		end
		refreshAll()
	end)

	-- slider drag: `ex` is the "effective" pixel position along the track. Normal drag moves it 1:1 with the
	-- cursor; holding Left Shift moves it at 1/10 speed, so you can switch between coarse and fine mid-drag
	-- without the value jumping.
	local FINE_SCALE = 0.1
	local dragging = false
	local ex, lastX = 0, 0

	local function valueAt(px: number): number
		return FOV_MIN + math.clamp(px / track.AbsoluteSize.X, 0, 1) * (FOV_MAX - FOV_MIN)
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			lastX = input.Position.X
			local width = track.AbsoluteSize.X
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				-- fine mode from the start: begin at the current value instead of jumping to the cursor
				ex = (S.Fov - FOV_MIN) / (FOV_MAX - FOV_MIN) * width
			else
				ex = math.clamp(lastX - track.AbsolutePosition.X, 0, width)
				setFov(valueAt(ex))
			end
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			local x = input.Position.X
			local dx = x - lastX
			lastX = x
			local fine = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			ex = math.clamp(ex + dx * (fine and FINE_SCALE or 1), 0, track.AbsoluteSize.X)
			setFov(valueAt(ex))
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	table.insert(refreshers, refresh)
	refresh()
end

-- hue/saturation color wheel (brightness is the slider below it)
local function makeColorWheel(text: string)
	local WHEEL = 150
	local row = makeRow(WHEEL + 44)

	new("TextLabel", {
		Size = UDim2.new(0.5, 0, 0, 24),
		Position = UDim2.fromOffset(12, 4),
		BackgroundTransparency = 1,
		Text = text,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = THEME.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)
	local hexLabel = new("TextLabel", {
		Size = UDim2.new(0.4, -40, 0, 24),
		Position = UDim2.new(0.5, 0, 0, 4),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = THEME.Dim,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, row)
	local swatch = new("Frame", {
		Size = UDim2.fromOffset(22, 22),
		Position = UDim2.new(1, -34, 0, 5),
		BorderSizePixel = 0,
	}, row)
	round(swatch, 5)

	local wheel = new("Frame", {
		Size = UDim2.fromOffset(WHEEL, WHEEL),
		Position = UDim2.new(0.5, -WHEEL / 2, 0, 34),
		BackgroundTransparency = 1,
	}, row)

	-- 180 spokes, each fading from white (center) to the full hue (edge)
	local SPOKES = 180
	for i = 0, SPOKES - 1 do
		local hue = i / SPOKES
		local spoke = new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5), -- rotates around the wheel's center
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(WHEEL / 2, 4),
			Rotation = hue * 360,
			BorderSizePixel = 0,
			BackgroundColor3 = Color3.new(1, 1, 1),
		}, wheel)
		new("UIGradient", {
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(hue, 1, 1)),
		}, spoke)
	end

	-- darkens the wheel to match the brightness slider
	local shade = new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
	}, wheel)
	new("UICorner", { CornerRadius = UDim.new(1, 0) }, shade)

	-- marker: white disc with a dark outline, filled with the current color
	local marker = new("Frame", {
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, wheel)
	round(marker, 7)
	new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 2 }, marker)
	local markerFill = new("Frame", {
		Size = UDim2.new(1, -4, 1, -4),
		Position = UDim2.fromOffset(2, 2),
		BorderSizePixel = 0,
	}, marker)
	round(markerFill, 5)

	local hit = new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
	}, wheel)

	local function refresh()
		local color = Color3.fromHSV(S.ESPHue, S.ESPSat, S.ESPVal)
		swatch.BackgroundColor3 = color
		markerFill.BackgroundColor3 = color
		hexLabel.Text = "#" .. string.upper(color:ToHex())
		shade.BackgroundTransparency = S.ESPVal -- 1 = bright, 0 = black

		local angle = S.ESPHue * 2 * math.pi
		local dist = S.ESPSat * (WHEEL / 2)
		marker.Position = UDim2.fromOffset(WHEEL / 2 + math.cos(angle) * dist - 7, WHEEL / 2 + math.sin(angle) * dist - 7)
	end

	local dragging = false
	local function pick(input: InputObject)
		local center = hit.AbsolutePosition + hit.AbsoluteSize / 2
		local d = Vector2.new(input.Position.X, input.Position.Y) - center
		S.ESPSat = math.clamp(d.Magnitude / (hit.AbsoluteSize.X / 2), 0, 1)
		if d.Magnitude > 1 then
			S.ESPHue = (math.atan2(d.Y, d.X) / (2 * math.pi)) % 1
		end
		refreshAll()
	end

	hit.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			pick(input)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			pick(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	table.insert(refreshers, refresh)
	refresh()
end

